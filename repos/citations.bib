% What to cite when you use the code in repos/, one section per repo.
%
% Paper entries are copied unchanged from docs/papers/citations.bib
% (itself copied from each upstream README where the README asks for a
% citation), so keys match what people copied from upstream. If you
% change one here, change it there too. Repos without a paper get a
% "software" entry; add the version you used (version = {...}) and that
% release's year. "software" is a biblatex entry type; classic BibTeX styles
% warn and treat it as "misc".
%
% Which entries each repo asks for is in repos/README.md. Checked on
% 2026-10-25 against the submodule commits recorded in this repo.


% ===================================================================
% umap (umap-learn)
% ===================================================================

% Asked for in repos/umap/README.rst, "Citation": the JOSS paper whenever
% you use the software, the arXiv paper for the algorithm. SMG2020 if you use
% Parametric UMAP, NBC2020 if you use densMAP, Healy2024 if the Nature
% Primer helped you.

@article{mcinnes2018umap-software,
  title={UMAP: Uniform Manifold Approximation and Projection},
  author={McInnes, Leland and Healy, John and Saul, Nathaniel and Grossberger, Lukas},
  journal={The Journal of Open Source Software},
  volume={3},
  number={29},
  pages={861},
  year={2018}
}


